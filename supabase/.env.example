# Copy to supabase/.env locally; never commit the populated file.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied automatically on deploy.
TIKTOK_CLIENT_KEY=replace-with-tiktok-client-key
TIKTOK_CLIENT_SECRET=replace-with-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://PROJECT_REF.supabase.co/functions/v1/tiktok-link
BRAT_APP_ORIGIN=https://oakvx.github.io
BRAT_APP_URL=https://oakvx.github.io/bratAnimator/
