# Local credentials and Supabase CLI state must never be published to Pages.
.env
.env.*
!.env.example
supabase/.temp/
supabase/.branches/
node_modules/

# Do not accidentally publish separately sourced Windows audio files.
# See assets/sounds/windows7/README.md for local setup and rights guidance.
assets/sounds/windows7/*.wav
assets/sounds/windows7/*.WAV
